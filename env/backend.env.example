# Backend environment — deployment reference (Cloud Run)
#
# VARIABLE NAMES ONLY. Real values are set as Cloud Run env vars (non-secret)
# or Secret Manager secrets (secret). Never commit a real value.
#
# Secret Manager (via --set-secrets): DATABASE_URL, JWT_ACCESS_SECRET,
#   PAYMENT_MOCK_WEBHOOK_SECRET
# Plain env (via --set-env-vars): everything else below.
#
# The authoritative, fully-commented list lives in backend/.env.example. This
# file is the deploy-time subset with production-appropriate values.

# --- runtime ---
NODE_ENV=production
# PORT is injected by Cloud Run — do not set it.
LOG_LEVEL=info
LOG_PRETTY=false
SWAGGER_ENABLED=false
TRUSTED_PROXY_HOPS=1
BODY_LIMIT=1mb
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=120

# Browser origins allowed to call the API (the admin app's Vercel + custom domain)
CORS_ALLOWED_ORIGINS=

# --- secret (Secret Manager) ---
DATABASE_URL=
JWT_ACCESS_SECRET=
PAYMENT_MOCK_WEBHOOK_SECRET=

# --- auth / OTP ---
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_REQUESTS_PER_HOUR=5

# --- providers (mock until real contracts/credentials exist) ---
SMS_PROVIDER=mock
PUSH_PROVIDER=mock
PAYMENT_GATEWAY=mock
PAYMENT_SANDBOX=true

# --- pricing / VAT / loyalty (business-confirmed values) ---
VAT_STANDARD_RATE=0.15
PRICES_INCLUDE_VAT=true
DELIVERY_FEE_TAXABLE=true
LOYALTY_POINTS_PER_SAR=1

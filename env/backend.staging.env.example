# Backend environment — STAGING (Cloud Run: rami-api-staging)
#
# Production-like but isolated: its OWN Cloud SQL instance/database and its OWN
# Secret Manager secrets (…_STAGING). Never points at production data.
#
# VARIABLE NAMES ONLY — real values are Cloud Run env vars (non-secret) or
# Secret Manager secrets. Never commit a real value.

# --- runtime ---
NODE_ENV=production
LOG_LEVEL=debug
LOG_PRETTY=false
# Swagger ON in staging so the team can exercise the API; OFF in prod.
SWAGGER_ENABLED=true
TRUSTED_PROXY_HOPS=1
BODY_LIMIT=1mb
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=120

# Staging admin/customer origins (staging Vercel + preview URLs).
CORS_ALLOWED_ORIGINS=

# --- secret (Secret Manager, staging copies) ---
# Referenced at deploy time as DATABASE_URL=DATABASE_URL_STAGING:latest, etc.
DATABASE_URL=
JWT_ACCESS_SECRET=
PAYMENT_MOCK_WEBHOOK_SECRET=

# --- auth / OTP ---
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_REQUESTS_PER_HOUR=5
# Demo/staging convenience: pin the mock OTP so testers can always log in.
# NEVER set this in production.
OTP_DEMO_FIXED_CODE=123456

# --- providers (all mock in staging until real credentials are approved) ---
SMS_PROVIDER=mock
PUSH_PROVIDER=mock
PAYMENT_GATEWAY=mock
PAYMENT_SANDBOX=true

# --- pricing / VAT / loyalty (business-confirmed values) ---
VAT_STANDARD_RATE=0.15
PRICES_INCLUDE_VAT=true
DELIVERY_FEE_TAXABLE=true
LOYALTY_POINTS_PER_SAR=1
